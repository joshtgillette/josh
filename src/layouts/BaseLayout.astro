---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div id="scroll-root">
      <main>
        <slot />
      </main>
    </div>
    <Footer />
    <script>
      // Private page-view beacon. Fires on initial load and every client-side
      // navigation, deduped per path per session. Skipped on localhost so dev
      // never counts. Counts are read from the hidden /api/views endpoint.
      function recordView() {
        const host = window.location.hostname;
        if (host === 'localhost' || host === '127.0.0.1') return;

        const key = window.location.pathname.replace(/^\/+|\/+$/g, '') || 'me';
        const seen = `viewed:${key}`;
        if (sessionStorage.getItem(seen)) return;
        sessionStorage.setItem(seen, '1');

        const url = `/api/views/${key}`;
        if (navigator.sendBeacon) {
          navigator.sendBeacon(url);
        } else {
          fetch(url, { method: 'POST', keepalive: true }).catch(() => {});
        }
      }

      document.addEventListener('astro:page-load', recordView);
    </script>
  </body>
</html>
